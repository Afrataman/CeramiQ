@model CeramiQ.Web.ViewModels.StockMovementCreateViewModel

@{
    ViewData["Title"] = "Yeni Stok Hareketi";
}

<div class="container-fluid">
    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none">
            ← Stok hareketlerine dön
        </a>

        <h2 class="mt-3 mb-1">Yeni Stok Hareketi</h2>

        <p class="text-muted">
            Seçilen ürün için stok giriş veya çıkış işlemi oluşturun.
        </p>
    </div>

    <div class="row">
        <div class="col-lg-8 col-xl-7">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">
                            <label asp-for="ProductId"
                                   class="form-label">
                            </label>

                            <select asp-for="ProductId"
                                    asp-items="Model.Products"
                                    class="form-select">
                                <option value="">Ürün seçiniz</option>
                            </select>

                            <span asp-validation-for="ProductId"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MovementType"
                                   class="form-label">
                            </label>

                            <select asp-for="MovementType"
                                    class="form-select">
                                <option value="">
                                    Hareket türü seçiniz
                                </option>
                                <option value="Giriş">
                                    Stok Girişi
                                </option>
                                <option value="Çıkış">
                                    Stok Çıkışı
                                </option>
                            </select>

                            <span asp-validation-for="MovementType"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Quantity"
                                   class="form-label">
                            </label>

                            <input asp-for="Quantity"
                                   class="form-control"
                                   type="number"
                                   min="0.01"
                                   step="0.01"
                                   placeholder="Örneğin: 250" />

                            <span asp-validation-for="Quantity"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Description"
                                   class="form-label">
                            </label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="4"
                                      maxlength="250"
                                      placeholder="Örneğin: Depoya yeni ürün girişi"></textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="alert alert-light border">
                            <strong>Bilgilendirme:</strong>
                            Stok girişinde miktar artar, stok çıkışında
                            miktar azalır. Mevcut stoktan fazla çıkış
                            yapılamaz.
                        </div>

                        <button type="submit" class="btn btn-primary">
                            Hareketi Kaydet
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary ms-2">
                            İptal
                        </a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}