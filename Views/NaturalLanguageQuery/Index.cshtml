@model CeramiQ.Web.ViewModels.NaturalLanguageQueryViewModel

@{
    ViewData["Title"] = "CeramiQ'ya Sor";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-body">
            <h2>CeramiQ'ya Sor</h2>

            <p class="text-muted">
                Ürünler ve üretim siparişleri hakkında doğal dilde soru yazabilirsiniz.
            </p>

            <form asp-controller="NaturalLanguageQuery"
                  asp-action="Index"
                  method="post">

                <div class="mb-3">
                    <label asp-for="Question" class="form-label"></label>

                    <textarea asp-for="Question"
                              class="form-control"
                              rows="4"
                              placeholder="Örneğin: Stoğu 50'den az olan ürünleri göster.">
                    </textarea>

                    <span asp-validation-for="Question"
                          class="text-danger">
                    </span>
                </div>

                <button type="submit" class="btn btn-primary">
                    Sorguyu Oluştur
                </button>
            </form>

            @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
                <div class="alert alert-danger mt-3">
                    @Model.ErrorMessage
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.GeneratedSql))
            {
                <div class="mt-4">
                    <h5>Oluşturulan SQL</h5>

                    <pre class="bg-light border rounded p-3"><code>@Model.GeneratedSql</code></pre>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.Explanation))
            {
                <div class="alert alert-info mt-3">
                    @Model.Explanation
                    @if (Model.ResultColumns.Count > 0)
                    {
                        <div class="mt-4">
                            <h5>Sorgu Sonucu</h5>

                            @if (Model.ResultRows.Count > 0)
                            {
                                <div class="table-responsive">
                                    <table class="table table-bordered table-striped">
                                        <thead class="table-dark">
                                            <tr>
                                                @foreach (string column in Model.ResultColumns)
                                                {
                                                    <th>@column</th>
                                                }
                                            </tr>
                                        </thead>

                                        <tbody>
                                            @foreach (Dictionary<string, string> row in Model.ResultRows)
                                            {
                                                <tr>
                                                    @foreach (string column in Model.ResultColumns)
                                                    {
                                                        <td>@row[column]</td>
                                                    }
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-warning">
                                    Bu sorguya uygun kayıt bulunamadı.
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}